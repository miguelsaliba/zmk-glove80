#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <input/processors.dtsi>

#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/glove80.h"
#include "labels.h"
#include "helpers.h"

// layers
#define BASE 0
#define NUM 1
#define NAV 2
#define SYS 3
#define SYM 4
#define MOUSE 5
#define MOUSESLOW 6
#define MOUSEFAST 7
#define MAGIC 8


#define ___ &trans

&mmv_input_listener {
    MOUSESLOW {
        layers = <MOUSESLOW>;
        input-processors = <&zip_xy_scaler 1 3>;
    };
    MOUSEFAST {
        layers = <MOUSEFAST>;
        input-processors = <&zip_xy_scaler 3 1>;
    };
};

&msc_input_listener {
    MOUSESLOW {
        layers = <MOUSESLOW>;
        input-processors = <&zip_scroll_scaler 1 3>;
    };
    MOUSEFAST {
        layers = <MOUSEFAST>;
        input-processors = <&zip_scroll_scaler 3 1>;
    };
};

/ {
    behaviors {
        magic: magic {
            compatible = "zmk,behavior-hold-tap";
            label = "MAGIC_HOLD_TAP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <190>;
            quick-tap-ms = <300>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <190>;
            quick-tap-ms = <300>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
        thumb: thumb_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
            quick-tap-ms = <250>;
        };

        bt_0: bt_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "BT_0";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_0>, <&bt BT_DISC 0>;
        };
        bt_1: bt_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "BT_1";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_1>, <&bt BT_DISC 1>;
        };
        bt_2: bt_2 {
            compatible = "zmk,behavior-tap-dance";
            label = "BT_2";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_2>, <&bt BT_DISC 2>;
        };
        bt_3: bt_3 {
            compatible = "zmk,behavior-tap-dance";
            label = "BT_3";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_3>, <&bt BT_DISC 3>;
        };
    };

    macros {
        rgb_ug_status_macro: rgb_ug_status_macro {
            label = "RGB_UG_STATUS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_STATUS>;
        };

        mod_tab_layer: mod_tab_layer {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings
                = <&macro_press &mo NAV>,
                  <&macro_param_1to1>,
                  <&macro_press &kp MACRO_PLACEHOLDER>,
                  <&macro_tap &kp TAB>,
                  <&macro_pause_for_release>,
                  <&macro_param_1to1>,
                  <&macro_release &kp MACRO_PLACEHOLDER>,
                  <&macro_release &mo NAV>;
        };

        bt_select_0: bt_select_0 {
            label = "BT_SELECT_0";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 0>;
        };
        bt_select_1: bt_select_1 {
            label = "BT_SELECT_1";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 1>;
        };
        bt_select_2: bt_select_2 {
            label = "BT_SELECT_2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 2>;
        };
        bt_select_3: bt_select_3 {
            label = "BT_SELECT_3";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 3>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_alttab_cursor {
            timeout-ms = <50>;
            key-positions = <LH1 LH2>;
            bindings = <&mod_tab_layer LALT>;
        };
    };
};

// -----------------------------------------------------------------------------------------------------------------------------------------
// |  F1   |  F2 |  F3 |  F4  |  F5  |                                                               |  F6   |  F7   |  F8  |   F9  |  F10 |
// |  =    |  1  |  2  |  3   |  4   |  5   |                                                 |  6   |   7   |   8   |  9   |   0   |   -  |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                                                 |  Y   |   U   |   I   |  O   |   P   |   \  |
// |  ESC  |  A  |  S  |  D   |  F   |  G   |                                                 |  H   |   J   |   K   |  L   |   ;   |   '  |
// |   `   |  Z  |  X  |  C   |  V   |  B   | LSHFT | LCTRL | LOWER | | LGUI  | RCTRL | RSHFT |  N   |   M   |   ,   |  .   |   /   | PGUP |
// | MAGIC | HOME| END | LEFT | RIGHT|      | BSPC  | DEL   | LALT  | | RALT  | RET   | SPACE |      |  UP   | DOWN  |  [   |   ]   | PGDN |

ZMK_BASE_LAYER(base,
&kp TAB    &kp Q       &kp W       &kp E        &kp R        &kp T    ,    &kp Y  &kp U         &kp I         &kp O        &kp P           &kp BSLH,
&kp ESC    &hml LGUI A &hml LALT S &hml LCTRL D &hml LSHFT F &kp G    ,    &kp H  &hmr RSHFT J  &hmr RCTRL K  &hmr RALT L  &hmr RGUI SEMI  &kp SQT,
&kp LSHFT  &kp Z       &kp X       &kp C        &kp V        &kp B    ,    &kp N  &kp M         &kp COMMA     &kp DOT      &kp FSLH        &kp RSHFT,
                           &thumb NAV BSPC  &thumb NUM DEL  &mo SYS   ,    &caps_word  &thumb SYM RET   &thumb MOUSE SPACE
)

ZMK_BASE_LAYER(number,
___   &kp N1 &kp N2 &kp N3 &kp N4 &kp N5      ,    &kp N6     &kp N7        &kp N8        &kp N9       &kp N0       &none,
___   ___    ___     ___   ___    ___         ,    &kp N0     &hmr LSHFT N4 &hmr LCTRL N5 &hmr LALT N6 &hmr LGUI N0 &none,
___   &none  &none  &none  &none  &none       ,    &none      &kp N1        &kp N2        &kp N3       ___          ___,
                             ___  ___  ___    ,    ___  ___  ___
)

ZMK_BASE_LAYER(navigation,
&none     &kp LC(A) &kp SPACE &kp TAB   &kp BSPC  &kp LC(X)          ,     &kp LC(X)  &kp LS(TAB)  &kp LC(Z)  &kp LC(Y)  &kp TAB    &none,
&none     &kp LGUI  &kp LALT  &kp LCTRL &kp LSHFT &kp LC(C)          ,     &kp LEFT   &kp DOWN     &kp UP     &kp RIGHT  &kp LC(C)  &none,
&kp LC(L) &kp LC(Z) &kp LC(X) &kp LC(C) &kp LC(V) &kp LC(LS(V))      ,     &kp LC(V)  &kp HOME     &kp PG_UP  &kp PG_DN  &kp END    &kp LC(L),
                                                     ___  ___  ___   ,   ___  ___  ___
)

ZMK_BASE_LAYER(system,
___  &kp C_BRI_UP &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &none      ,   &kp PAUSE_BREAK &kp F7 &kp F8 &kp F9 &kp F10 &none,
___  &kp C_BRI_DN &kp C_PREV &kp C_PP     &kp C_NEXT   &kp PSCRN  ,   &kp PSCRN       &kp F4 &kp F5 &kp F6 &kp F11 &none,
___  &kp LGUI     &kp LALT   &kp LCTRL    &kp LSHFT    &none      ,   &kp SLCK        &kp F1 &kp F2 &kp F3 &kp F12 ___,
                                                  ___  ___  ___   ,   ___  ___  ___
)

ZMK_BASE_LAYER(symbol,
&kp GRAVE  &kp LBKT  &kp LBRC  &kp RBRC  &kp RBKT &kp QMARK     ,     &kp GRAVE &none     &none     &none     &none    &none,
&kp HASH   &kp CARET &kp EQUAL &kp UNDER &kp DLLR &kp BSLH      ,     &kp DQT   &kp RSHFT &kp RCTRL &kp RALT  &kp RGUI &none,
&kp TILDE  &kp LT    &kp PIPE  &kp MINUS &kp GT   &kp PLUS      ,     &kp SQT   &none     &none     &kp SPACE &none    &none,
                                             ___  ___  ___      ,     ___  ___  ___
)


ZMK_BASE_LAYER(mouse,
&none  &none           &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &none       ,    &none     &mo MOUSESLOW  &mo MOUSEFAST &none     &none     &none,
&none  &msc SCRL_UP    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB5    ,    &mkp MB5  &sk RSHFT      &sk RCTRL     &sk RALT  &sk RGUI  &none,
&none  &msc SCRL_DOWN  &none           &mo MOUSESLOW   &mo MOUSEFAST    &mkp MB4    ,    &mkp MB4  &mkp LCLK      &mkp MCLK     &mkp RCLK &none     &none,
                                                &mkp LCLK    &mkp MCLK  &mkp RCLK   ,    ___  ___  ___
)

ZMK_BASE_LAYER(mouse_slow,
___ ___ ___ ___ ___ ___ , ___ ___ ___ ___ ___ ___,
___ ___ ___ ___ ___ ___ , ___ ___ ___ ___ ___ ___,
___ ___ ___ ___ ___ ___ , ___ ___ ___ ___ ___ ___,
            ___ ___ ___ , ___ ___ ___
